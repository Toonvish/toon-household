# Local stack test only; never use these values on a server.
#
# `docker compose --env-file .env.local-stack -p toon-household-local up -d`
# runs the whole stack on this machine under hostnames ending in .test, with
# Caddy's internal CA. COMPOSE_PROJECT_NAME gives it a project of its own:
# without it compose's `name: toon-household` would put the test on the
# production names (toon-household_toon-data), and a `down -v` run from a
# checkout on the server would delete the production data volume.
COMPOSE_PROJECT_NAME=toon-household-local
TOON_IMAGE=toon-household:local
TOON_HOSTNAME=haushalt.test
SESSION_SECRET=5c1e9a07d3b84f26a0e7c9b1d4f83a62e5170b9c8d3a4f61
TOON_TLS_ISSUER=internal
TOON_HSTS_MAX_AGE=0
RECIPE_HOSTNAME=rezepte.test
FINANCE_HOSTNAME=finanzen.test
