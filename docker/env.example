# ---------------------------------------------------------------------------
# toon-household - Docker/Compose environment
#
# On the server, put this next to docker-compose.yml as `.env`:
#     cp docker/env.example .env && nano .env
#
# The first three values are required. Everything else has a working default -
# the complete list of the application's variables is in /.env.example.
#
# TLS and the optional old-hostname redirects belong to the stack's own Caddy
# and are fed from this same file (see the OPTIONAL section).
# ---------------------------------------------------------------------------

# --- REQUIRED --------------------------------------------------------------

# The hostname the app is reachable under. EXACTLY THIS name must be used on all
# devices: the certificate is issued per name, access by IP address raises a new
# warning, and WEB_ORIGIN (and with it the links in outgoing mails) is built from
# it.
#
# Default case: a (sub)domain of your own whose A (and AAAA) record points at this
# server. Caddy then fetches a Let's Encrypt certificate by itself, and nothing
# has to be installed on the devices.
#
# Without a domain - a box on the LAN, no open ports - an internal name works too
# (`haushalt.fritz.box`, `haushalt.local`); then set TOON_TLS_ISSUER=internal
# below and install the root certificate per device (docs/deployment.md).
TOON_HOSTNAME=haushalt.example.org

# 32-byte random value. It signs the short-lived OAuth/PKCE cookies AND the
# signatures of the /uploads URLs.
#
#   openssl rand -hex 32
#
# WARNING: if this value is changed later, every image URL already handed out is
#   invalid (the images themselves are kept).
# Never reuse the secrets of the old toon-recipe / toon-finance installs here.
SESSION_SECRET=

# The image to run. `:latest` follows the newest `main` build; a `@sha256:...`
# digest (shown in the summary of every release run) pins the version until you
# change it - that is also the way to roll back. `toon-household-deploy` pins it
# for you.
TOON_IMAGE=ghcr.io/toonvish/toon-household:latest


# --- MAIL ------------------------------------------------------------------
#
# With nothing set the app sends NO mail: it writes every password-reset and
# invite link to the container log (`docker compose logs app`) and tells the UI
# that nothing was sent. For real delivery - resets and invites to outside
# addresses - enter a mail provider's SMTP access here. A mail server of your own
# on the server is not a good idea: fresh VPS addresses are on blocklists
# practically everywhere.
#
# MAIL_TRANSPORT=smtp is PART OF IT - without that line it stays at the log, no
# matter what MAIL_HOST says.
#
# MAIL_SECURITY: `tls` = implicit TLS (port 465, recommended), `starttls` =
# upgrade on port 587 (default), `none` only for a relay on your own network -
# the API refuses to start with credentials and `none`, they would go out in
# cleartext.
#MAIL_TRANSPORT=smtp
#MAIL_HOST=mx.example.net
#MAIL_PORT=465
#MAIL_SECURITY=tls
#MAIL_USER=haushalt@example.org
#MAIL_PASSWORD=

# RESEND works two ways, with the same preparation: verify the domain at Resend
# (put the shown MX/TXT records for Return-Path and DKIM into the DNS zone, add
# DMARC yourself) and create an API key with `Sending access`.
#
# (a) via the SMTP values above - MAIL_USER is literally `resend`, the API key is
#     the MAIL_PASSWORD:
#       MAIL_TRANSPORT=smtp / MAIL_HOST=smtp.resend.com / MAIL_PORT=465
#       MAIL_SECURITY=tls / MAIL_USER=resend / MAIL_PASSWORD=re_...
#
# (b) via the HTTP adapter, then without MAIL_HOST/MAIL_USER/MAIL_PASSWORD:
#MAIL_TRANSPORT=resend
#MAIL_API_KEY=re_...
#
# In both cases MAIL_FROM must be on the verified domain; a sender outside it is
# rejected.

# Sender of the outgoing mails. Must be an address the relay may send from -
# otherwise the mail is rejected or lands in spam. Without mail delivery set up
# the value is arbitrary, it only shows up in the log.
MAIL_FROM=Haushalt <haushalt@localhost>


# --- OPTIONAL --------------------------------------------------------------

# Old hostnames, for the cutover from toon-recipe and toon-finance ONLY. Set one
# and that old hostname redirects, path by path, to TOON_HOSTNAME (docs/deployment.md,
# "Cutover"; ADR 0008). Their DNS records must point at THIS server, and Caddy
# fetches a certificate for each. Remove both lines once the bookmarks and the
# installed apps have moved. Unset or empty means no redirect.
#RECIPE_HOSTNAME=rezepte.example.org
#FINANCE_HOSTNAME=finanzen.example.org

# Certificates, for EVERY site of this stack (the main hostname and the old ones).
# `acme` (default) = a real Let's Encrypt certificate; needs a publicly
# resolvable TOON_HOSTNAME and reachable ports 80 + 443. `internal` = Caddy's own
# local CA for a LAN without a domain; then TOON_HSTS_MAX_AGE=0 belongs with it
# (HSTS on a name you later use differently locks you out) and the root
# certificate has to be installed on every device. These two are Caddy settings,
# not the app's.
#TOON_TLS_ISSUER=acme
#TOON_HSTS_MAX_AGE=31536000

# Interface and content default language of the deployment: `de` (default) or
# `en`. Users still pick their own interface language.
#DEFAULT_LOCALE=de

# Memory ceiling of the app container. Without a limit the OOM killer may take
# the Docker daemon with it instead of just this container.
#
# Without photo/PDF import (default) only Bun, a libSQL file and the serving of
# the PWA run here: `768m` (default) fits a 1 GB VPS and is plenty there. With
# OCR the text recognition is the memory hog - then measure with `docker stats`
# during a photo import (IMPORT_OCR_CONCURRENCY caps the parallel tesseract
# processes) and set the peak plus a reserve instead of guessing:
#   1 GB RAM  -> 768m   (without OCR, and also WITH photo OCR: see below)
#   2 GB RAM  -> 1200m
#   4 GB RAM  -> 1500m
#
# Photo OCR needs NO higher limit here: measured is a 140 MB peak for the whole
# job (Bun + sharp + tesseract, 12 MP photo, IMPORT_OCR_CONCURRENCY=1), so 768m is
# plenty. A limit below the host's RAM still matters, so that a runaway INSIDE
# the container is killed and not on the host, where the OOM killer can hit sshd
# too.
#TOON_MEM_LIMIT=768m

# FEATURE FLAG: import from a PHOTO. Off unless this is 1.
#
# That is exactly what makes running on a small VPS comfortable: import by web
# address and by pasted text is pure fetch-and-parse, while OCR needs the
# `tesseract` binary (~105 MB with the language packs Debian pulls in) and holds
# sharp plus a decoded image in memory per job.
#
# TWO SWITCHES, BOTH NEEDED: the image contains the binary only if it was built
# with `--build-arg WITH_OCR=1`. **The published image from GHCR is built that
# way** (tesseract + German language pack, no poppler), so the first switch is all
# you need. Whoever builds a slim image of their own needs both. Setting this to 1
# without a tesseract in the image only seems to enable the endpoints: the import
# then answers 422 and names the missing binary.
#
# ON 1 GB RAM AND ONE CORE THIS IS THE RECOMMENDED COMBINATION: photo import on,
# PDF import off (see IMPORT_PDF_ENABLED), IMPORT_OCR_CONCURRENCY=1, plus swap.
#
# MEASURED in the container (`--memory=1g --cpus=1`, 12 MP photo,
# TESSERACT_LANGS=deu): 2.3 s and a 140 MB peak for the WHOLE job - Bun, sharp and
# the tesseract process together. tesseract alone is ~44 MB of that. The vCore of
# a small VPS is slower than the test core, so realistically 5-15 s per photo;
# the memory stays the same. The default limit of 768m is enough for it.
IMPORT_OCR_ENABLED=0

# FEATURE FLAG: import from a PDF. The compose file defaults to 0.
#
# A switch of its own because a PDF is an order of magnitude more expensive than
# a photo: a scan is up to 10 tesseract runs plus poppler, and even a digital PDF
# hands unpdf the whole parsed document. On one core a ten-page scan runs into the
# server's 60 s limit in EVERY case - with 4 GB RAM just as with 1 GB. Hence
# deliberately 0 on the small server: the UI then hides PDF instead of offering a
# button that runs into a timeout.
#
# Turning it to 1 also needs an image built with `--build-arg WITH_PDF=1` (poppler,
# +28 MB) - the published GHCR image does NOT have it. Without poppler the PDF
# import answers with the documented 422.
#
# That is why the compose file sets an explicit 0 and not "empty": empty would
# mean "like IMPORT_OCR_ENABLED" at the API level, and that would switch PDF on
# against an image that cannot do it.
IMPORT_PDF_ENABLED=0

# OCR languages, "+"-separated, German first. Only relevant when
# IMPORT_OCR_ENABLED is set. The text recognition calls the native `tesseract`
# binary, so EVERY language here needs its Debian package in the image.
# `tesseract-ocr-deu` and `tesseract-ocr-eng` are in (Debian pulls the latter in
# as a hard dependency, so it costs nothing extra). Entering a language without a
# package only fails at import time - then add the package to the Dockerfile.
# Nothing is downloaded at runtime.
#
# ONLY "deu" IS THE DEFAULT, and on one core that is no detail: two language
# models mean double the work per page. Extend to "deu+eng" if English recipes
# are photographed regularly - the recipe parsers themselves are German anyway.
TESSERACT_LANGS=deu

# How many OCR jobs may run at once, process-wide. That is directly the number of
# parallel tesseract processes, so the memory ceiling of the app.
#
# 1 is the default and on one core also the maximum that makes sense: two jobs
# share the same core and then both take twice as long, so they rather run into
# the timeout. Whoever raises it anyway measures with `docker stats` during two
# parallel photo imports first.
#
# An import that finds no slot WAITS up to 30 s for a free one and only then
# answers 429 - two people at once means "the second takes longer", not "error,
# try again".
IMPORT_OCR_CONCURRENCY=1

# --- OAuth (empty on purpose) ----------------------------------------------
# E-mail + password is the self-hosted way and needs nobody's servers.
# Google/GitHub are third parties by nature; fill in only if that is wanted.
# Redirect URI at the provider then: https://${TOON_HOSTNAME}/api/auth/oauth/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Demo data -------------------------------------------------------------
# `bun run seed` refuses to run with NODE_ENV=production unless ALLOW_SEED=1 and
# SEED_PASSWORD (10+ characters) are both set. Pass them once with
# `docker compose exec -e ALLOW_SEED=1 -e SEED_PASSWORD=... app ...`; never store
# them in this file.
